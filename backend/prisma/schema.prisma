// Prisma Schema for Supabase PostgreSQL
// Configured for Supabase Auth, Storage, and E-Commerce & Admin workflow

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum PaymentType {
  IN_STORE
  ONLINE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum FulfillmentStatus {
  PENDING
  PROCESSING
  COMPLETED
  CANCELLED
}

model User {
  id          String   @id @default(uuid())
  supabaseUid String?  @unique // Mapped to Supabase auth.users.id
  email       String   @unique
  name        String
  role        Role     @default(CUSTOMER)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders Order[]

  @@map("users")
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products Product[]

  @@map("categories")
}

model Product {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  price       Decimal  @db.Decimal(12, 2)
  stock       Int      @default(0)
  imageUrl    String?  // Supabase Storage URL
  isDeleted   Boolean  @default(false) // Soft-delete flag
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  orderItems OrderItem[]

  @@map("products")
}

model PaymentMethod {
  id           String      @id @default(uuid())
  name         String
  code         String      @unique // e.g. "CASH_STORE", "QRIS_ONLINE", "BANK_TRANSFER"
  type         PaymentType @default(ONLINE)
  isActive     Boolean     @default(true)
  instructions String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  orders Order[]

  @@map("payment_methods")
}

model Order {
  id                String            @id @default(uuid())
  orderCode         String            @unique // e.g. "ORD-20260922-8921"
  userId            String?
  user              User?             @relation(fields: [userId], references: [id])
  customerName      String?           // For guest checkout or store order reference
  customerPhone     String?
  totalAmount       Decimal           @db.Decimal(12, 2)
  paymentStatus     PaymentStatus     @default(PENDING)
  fulfillmentStatus FulfillmentStatus @default(PENDING)
  paymentMethodId   String
  paymentMethod     PaymentMethod     @relation(fields: [paymentMethodId], references: [id])
  notes             String?
  paymentProofUrl   String?           // Supabase Storage URL for uploaded payment receipt
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  orderItems OrderItem[]

  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Decimal @db.Decimal(12, 2)
  subtotal  Decimal @db.Decimal(12, 2)

  @@map("order_items")
}
