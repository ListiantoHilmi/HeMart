# Supabase & PostgreSQL Connection Configuration
# Substitute with your actual Supabase project credentials

# Database URL for Prisma (Transaction mode or Direct connection)
DATABASE_URL="postgresql://postgres:your-db-password@db.your-supabase-project.supabase.co:5432/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres:your-db-password@db.your-supabase-project.supabase.co:5432/postgres"

# Supabase API Settings
SUPABASE_URL="https://your-supabase-project.supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key"

# Express Backend Server Configuration
PORT=5000
JWT_SECRET="super-secret-jwt-key-for-local-tokens"
CORS_ORIGIN="http://localhost:5173"
